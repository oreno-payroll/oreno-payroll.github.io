# Payroll: private-by-default Git allowlist.
# Only reviewed source/config files are eligible for a commit.
# IMPORTANT: .gitignore does not protect files that Git is ALREADY tracking.
# It also does not detect credentials or personal information written inside allowed source files.

# Ignore everything at the project root unless explicitly re-allowed below.
/*

# Project metadata (tracked deliberately).
!/.gitignore
!/README.md
!/package.json
!/package-lock.json
!/tsconfig.json

# Source folders (the folders themselves must be re-allowed first).
!/src/
!/public/
!/scripts/

# TypeScript application code only.
/src/**
!/src/**/
!/src/**/*.ts
!/src/**/*.tsx

# HTML/CSS source used to generate dist/.
# Assets such as PDFs, images, fonts, JSON, and raw data remain ignored.
/public/**
!/public/**/
!/public/**/*.html
!/public/**/*.css

# PDF閲覧用Service Workerだけは、JavaScriptを明示的にGit管理する。
# ビルド成果物ではなく public/view/ にある原本ソース。
!/public/view/pdf-sw.js

# Reviewed build/test scripts only.
/scripts/**
!/scripts/**/
!/scripts/**/*.mjs
!/scripts/**/*.js
!/scripts/**/*.cjs
!/scripts/**/*.sh

# Note: dist/, node_modules/, local-data/, backups/, *.pdf, *.payroll,
# *.zip, *.json (except named config above), *.csv, *.sqlite, images,
# documents, .env*, keys, archives, logs, and ALL unknown extensions
# are ignored automatically by the top-level deny rule and allowlists.
# Any newly needed file type/path requires an intentional .gitignore review.

# GitHub Pages: allow only the reviewed deployment workflow.
!/.github/
/.github/**
!/.github/workflows/
/.github/workflows/**
!/.github/workflows/deploy.yml

# Finance v1.1と同じバージョンのレビュー済みMSALバンドルとライセンスのみ許可。
!/public/vendor/msal/msal-browser.bundle.js
!/public/vendor/msal/LICENSE.txt

# SharedWorkerは復号鍵をメモリだけで受け渡すための監査済みのソース。
!/public/payroll-cloud-session.js
